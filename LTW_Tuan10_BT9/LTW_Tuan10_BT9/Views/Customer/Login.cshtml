@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 w-50">
    <h3 class="text-center text-primary mb-4">ĐĂNG NHẬP</h3>

    @if (ViewBag.ThongBao != null)
    {
        <div class="alert alert-danger">@ViewBag.ThongBao</div>
    }

    @using (Html.BeginForm("Login", "Customer", FormMethod.Post))
    {
        <div class="form-group">
            <label for="TaiKhoan">Tên đăng nhập</label>
            <input type="text" class="form-control" id="TaiKhoan" name="TaiKhoan" placeholder="Nhập tên đăng nhập" required />
        </div>

        <div class="form-group">
            <label for="MatKhau">Mật khẩu</label>
            <input type="password" class="form-control" id="MatKhau" name="MatKhau" placeholder="Nhập mật khẩu" required />
        </div>

        <button type="submit" name="submitButton" value="Đăng nhập" class="btn btn-primary mt-2">Đăng nhập</button>
        <button type="submit" name="submitButton" value="Đăng ký" class="btn btn-secondary mt-2">Đăng ký</button>
    }
</div>
