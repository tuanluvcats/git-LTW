@using LTW_Tuan10_BT9.Models;
@{
    ViewBag.Title = "Main";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Func<string, int, string> Truncate = (input, length) =>
    {
        if (String.IsNullOrEmpty(input)) return "";
        return input.Length <= length ? input : input.Substring(0, length) + "...";
    };
}


    <div class="row">
        @foreach (Sach s in Model)
        {
            <div class="col-lg-3 card mr-2 mt-2 text-center">
                <div class="card">
                    <img style="width:300px; height:350px;" class="card-img-top mt-2" src="~/Content/images/@s.AnhBia">
                    <div class="card-body">
                        <h5 style="font-size:30px;" class="card-title">@Truncate(s.TenSach, 30)</h5>
                        @Html.ActionLink("Chi tiết", "Detail", "Details", new { id = s.MaSach }, new { @class = "btn btn-warning" })

                        @Html.ActionLink("Chọn", "Details", "Home", new { id = s.MaSach }, new { @class = "btn btn-warning" })
                    </div>
                </div>
            </div>
        }
    </div>
