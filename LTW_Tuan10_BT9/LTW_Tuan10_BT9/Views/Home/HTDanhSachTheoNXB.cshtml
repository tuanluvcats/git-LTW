@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<LTW_Tuan10_BT9.Models.Sach>
<h3>Sách thuộc chủ đề: @ViewBag.NhaXuatBan</h3>
<div class="row">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var s in Model)
        {
            <div class="col-md-3 border p-2">
                <img src="@Url.Content("~/Content/images/" + s.AnhBia)" class="w-100" alt="@s.TenSach" />
                <p>@s.TenSach</p>
            </div>
        }
    }
    else
    {
        <p>Không có sách của nhà xuất bản này.</p>
    }
</div>
